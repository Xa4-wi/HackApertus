# Default prototype model; switch to swiss-ai/Apertus-v1.5-70B if available.
LLM_NAME=swiss-ai/Apertus-v1.5-8B
# Leave blank for the offline demo. Use the endpoint supplied with your key.
LLM_BASE_URL=
LLM_API_KEY=
# Evaluator BASE_URL / API_KEY take precedence, including empty values.
# BASE_URL=https://api.inference.cscs.ch/v1
# API_KEY=put-your-key-here-locally
LLM_TIMEOUT_SECONDS=120
# Match the inference server's configured context window.
CONTEXT_TOKENS=8192
DOCUMENT_TIMEOUT_SECONDS=1800
MAX_DOCUMENT_MODEL_CALLS=48

# Local Apertus 8B Q4_K_M (see docs/local-model.md):
# BASE_URL=http://127.0.0.1:8081/v1
# API_KEY=
# LOCAL_MODEL_ID=claimlens-apertus-v1.5-8b-q4
# LLM_TIMEOUT_SECONDS=300
# CONTEXT_TOKENS=16384
# Start the inference server in another terminal: make model-serve
